# Runtime
APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8081

# Google Cloud (required by later phases)
GCP_PROJECT_ID=secure-file-processing
FIRESTORE_DATABASE_ID=dev-db
GCS_BUCKET_NAME=secure-file-processing-dev
QUARANTINE_PREFIX=quarantine/
TRUSTED_PREFIX=trusted/

# Security limits
MAX_FILE_SIZE=52428800
MAX_ARCHIVE_EXTRACTED_SIZE=209715200
MAX_ARCHIVE_FILES=1000
MAX_ARCHIVE_NESTING_DEPTH=3

# Malware scanner (required by the scanner phase)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
